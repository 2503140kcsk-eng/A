module

public import BudgetFreeBandits.PointSpikeGapAlgebra
public import BudgetFreeBandits.SequentialKL
public import Mathlib.Probability.ProbabilityMassFunction.Constructions

noncomputable section

namespace BudgetFreeBandits


/-- A one-step finite PMF on the selected action and its observed reward. -/
def pointSpikeJointStepPMF {A : ℕ}
    (policy : PMF (Fin A)) (reward : Fin A → PMF (Fin 3)) :
    PMF (Fin A × Fin 3) :=
  policy.bind fun a => (reward a).map fun x => (a, x)

/-- The full finite history law generated by a history-dependent policy. -/
def pointSpikeTranscriptPMF {A : ℕ}
    (policy : (t : ℕ) → SequentialHistory (Fin A) (Fin 3) t → PMF (Fin A))
    (reward : (t : ℕ) → Fin A → PMF (Fin 3)) :
    (t : ℕ) → PMF (SequentialHistory (Fin A) (Fin 3) t)
  | 0 => PMF.pure PUnit.unit
  | t + 1 =>
      (pointSpikeTranscriptPMF policy reward t).bind fun h =>
        (policy t h).bind fun a =>
          (reward t a).map fun x => (h, (a, x))

/-- A finite reward PMF mapped into the fixed history/action prefix. -/
private theorem pointSpikeRewardMap_apply {A : ℕ} (t : ℕ)
    [DecidableEq (SequentialHistory (Fin A) (Fin 3) t)]
    [DecidableEq (Fin A)]
    (reward : Fin A → PMF (Fin 3))
    (h h' : SequentialHistory (Fin A) (Fin 3) t)
    (a a' : Fin A) (x : Fin 3) :
    ((reward a').map fun y => (h', (a', y))) (h, (a, x)) =
      if h' = h ∧ a' = a then reward a' x else 0 := by
  classical
  by_cases hh : h' = h
  · subst h'
    by_cases ha : a' = a
    · subst a'
      simp [PMF.map_apply, tsum_fintype]
    · have hneq : a ≠ a' := fun hEq => ha hEq.symm
      simp [PMF.map_apply, hneq, ha, Prod.mk.injEq, tsum_fintype]
  · have hneq : h ≠ h' := fun hEq => hh hEq.symm
    simp [PMF.map_apply, hneq, hh, Prod.mk.injEq, tsum_fintype]

/--
Exact one-path probability recursion. The probability of extending a
history by action a and reward x is the old history probability times the
policy's conditional action probability times the selected reward mass.
-/
theorem pointSpikeTranscriptPMF_apply_succ {A : ℕ}
    (policy : (t : ℕ) → SequentialHistory (Fin A) (Fin 3) t → PMF (Fin A))
    (reward : (t : ℕ) → Fin A → PMF (Fin 3))
    (t : ℕ) (h : SequentialHistory (Fin A) (Fin 3) t)
    (a : Fin A) (x : Fin 3) :
    pointSpikeTranscriptPMF policy reward (t + 1) (h, (a, x)) =
      pointSpikeTranscriptPMF policy reward t h *
        policy t h a * reward t a x := by
  classical
  change ((pointSpikeTranscriptPMF policy reward t).bind fun h' =>
      (policy t h').bind fun a' =>
        (reward t a').map fun y => (h', (a', y))) (h, (a, x)) = _
  rw [PMF.bind_apply]
  simp_rw [PMF.bind_apply, pointSpikeRewardMap_apply]
  rw [tsum_eq_single h]
  · rw [tsum_eq_single a]
    · simp [mul_assoc]
    · intro a' ha
      simp [ha]
  · intro h' hh
    simp [hh]

/-- The baseline reward law, independent of action and time. -/
def pointSpikeBaselineReward {A : ℕ} :
    ℕ → Fin A → PMF (Fin 3) :=
  fun _ _ => spikeBasePMF

/-- The point-spike alternative changes only the target action from tau onward. -/
def pointSpikeAlternativeReward {A : ℕ}
    (target : Fin A) (tau : ℕ) : ℕ → Fin A → PMF (Fin 3) :=
  fun t a => if tau ≤ t + 1 ∧ a = target then
    spikeAlternativePMF else spikeBasePMF

/-- Number of post-change pulls of the target action along a complete path. -/
def pointSpikePullCount {A : ℕ} (target : Fin A) (tau : ℕ) :
    (t : ℕ) → SequentialHistory (Fin A) (Fin 3) t → ℕ
  | 0, _ => 0
  | t + 1, (h, (a, _x)) =>
      pointSpikePullCount target tau t h +
        if tau ≤ t + 1 ∧ a = target then 1 else 0

/-- Baseline finite transcript PMF for an arbitrary history-dependent policy. -/
def pointSpikeBaseTranscriptPMF {A : ℕ}
    (policy : (t : ℕ) → SequentialHistory (Fin A) (Fin 3) t → PMF (Fin A)) :
    (t : ℕ) → PMF (SequentialHistory (Fin A) (Fin 3) t) :=
  pointSpikeTranscriptPMF policy pointSpikeBaselineReward

/-- Alternative finite transcript PMF for an arbitrary history-dependent policy. -/
def pointSpikeAltTranscriptPMF {A : ℕ}
    (policy : (t : ℕ) → SequentialHistory (Fin A) (Fin 3) t → PMF (Fin A))
    (target : Fin A) (tau : ℕ) :
    (t : ℕ) → PMF (SequentialHistory (Fin A) (Fin 3) t) :=
  pointSpikeTranscriptPMF policy (pointSpikeAlternativeReward target tau)

/--
On every reward point possible under the baseline, the baseline-to-alternative
one-step likelihood ratio is 5/3 exactly when the target action has changed,
and is 1 otherwise. The marker point is outside baseline support.
-/
theorem pointSpike_reward_likelihood_ratio {A : ℕ}
    (target : Fin A) (tau t : ℕ) (a : Fin A) (x : Fin 3)
    (hbase : spikeBasePMF x ≠ 0) :
    (spikeBasePMF x).toReal /
        (pointSpikeAlternativeReward target tau t a x).toReal =
      if tau ≤ t + 1 ∧ a = target then (5 / 3 : ℝ) else 1 := by
  classical
  by_cases hchange : tau ≤ t + 1 ∧ a = target
  · simp [pointSpikeAlternativeReward, hchange]
    fin_cases x <;> norm_num [spikeBasePMF, spikeAlternativePMF] at *
  · simp [pointSpikeAlternativeReward, hchange]
    fin_cases x <;> norm_num [spikeBasePMF, spikeAlternativePMF] at *

/-- Baseline finite-history mass recurrence. -/
theorem pointSpikeBaseTranscriptPMF_apply_succ {A : ℕ}
    (policy : (t : ℕ) → SequentialHistory (Fin A) (Fin 3) t → PMF (Fin A))
    (t : ℕ) (h : SequentialHistory (Fin A) (Fin 3) t)
    (a : Fin A) (x : Fin 3) :
    pointSpikeBaseTranscriptPMF policy (t + 1) (h, (a, x)) =
      pointSpikeBaseTranscriptPMF policy t h * policy t h a * spikeBasePMF x := by
  simpa [pointSpikeBaseTranscriptPMF, pointSpikeBaselineReward] using
    (pointSpikeTranscriptPMF_apply_succ policy pointSpikeBaselineReward t h a x)

/-- Alternative finite-history mass recurrence. -/
theorem pointSpikeAltTranscriptPMF_apply_succ {A : ℕ}
    (policy : (t : ℕ) → SequentialHistory (Fin A) (Fin 3) t → PMF (Fin A))
    (target : Fin A) (tau t : ℕ)
    (h : SequentialHistory (Fin A) (Fin 3) t)
    (a : Fin A) (x : Fin 3) :
    pointSpikeAltTranscriptPMF policy target tau (t + 1) (h, (a, x)) =
      pointSpikeAltTranscriptPMF policy target tau t h *
        policy t h a * pointSpikeAlternativeReward target tau t a x := by
  simpa [pointSpikeAltTranscriptPMF] using
    (pointSpikeTranscriptPMF_apply_succ policy
      (pointSpikeAlternativeReward target tau) t h a x)

/-- Positive alternative probability on every baseline-supported finite transcript. -/
theorem pointSpikeAltTranscriptPMF_pos_of_base
    {A : ℕ}
    (policy : (t : ℕ) → SequentialHistory (Fin A) (Fin 3) t → PMF (Fin A))
    (target : Fin A) (tau : ℕ) :
    ∀ t (h : SequentialHistory (Fin A) (Fin 3) t),
      pointSpikeBaseTranscriptPMF policy t h ≠ 0 →
        pointSpikeAltTranscriptPMF policy target tau t h ≠ 0 := by
  intro t
  induction t with
  | zero =>
      intro h hbase
      change (PMF.pure PUnit.unit) h ≠ 0 at hbase ⊢
      exact hbase
  | succ t ih =>
      intro h
      rcases h with ⟨hprev, a, x⟩
      intro hbase
      rw [pointSpikeBaseTranscriptPMF_apply_succ] at hbase
      have hbasePrev :
          pointSpikeBaseTranscriptPMF policy t hprev ≠ 0 := by
        intro hz
        apply hbase
        simp [hz]
      have hpolicy : policy t hprev a ≠ 0 := by
        intro hz
        apply hbase
        simp [hz]
      have hreward : spikeBasePMF x ≠ 0 := by
        intro hz
        apply hbase
        simp [hz]
      have haltPrev := ih hprev hbasePrev
      have haltReward :
          pointSpikeAlternativeReward target tau t a x ≠ 0 := by
        by_cases hchange : tau ≤ t + 1 ∧ a = target
        · simpa [pointSpikeAlternativeReward, hchange] using
            (spike_alternative_positive_on_base_support x hreward)
        · simpa [pointSpikeAlternativeReward, hchange] using hreward
      rw [pointSpikeAltTranscriptPMF_apply_succ]
      exact mul_ne_zero (mul_ne_zero haltPrev hpolicy) haltReward



/-- A nonzero mass of a PMF has nonzero real value. -/
private theorem pointSpikePMF_toReal_ne_zero {α : Type*}
    (p : PMF α) (x : α) (hp : p x ≠ 0) :
    (p x).toReal ≠ 0 := by
  exact ENNReal.toReal_ne_zero.mpr ⟨hp, p.apply_ne_top x⟩

/--
The likelihood ratio of a complete finite transcript is exactly
(5/3) to the number of post-change pulls of the target arm.
The same history-dependent policy is used under both environments, so
its action probability cancels at each recursion step.
-/
theorem pointSpikeTranscript_toReal_likelihood_ratio {A : ℕ}
    (policy : (t : ℕ) → SequentialHistory (Fin A) (Fin 3) t → PMF (Fin A))
    (target : Fin A) (tau : ℕ) :
    ∀ t (h : SequentialHistory (Fin A) (Fin 3) t),
      pointSpikeBaseTranscriptPMF policy t h ≠ 0 →
        (pointSpikeBaseTranscriptPMF policy t h).toReal /
          (pointSpikeAltTranscriptPMF policy target tau t h).toReal =
            (5 / 3 : ℝ) ^ pointSpikePullCount target tau t h := by
  intro t
  induction t with
  | zero =>
      intro h hbase
      have hh : h = PUnit.unit := by
        simpa [pointSpikeBaseTranscriptPMF, pointSpikeTranscriptPMF] using hbase
      subst h
      simp [pointSpikeBaseTranscriptPMF, pointSpikeAltTranscriptPMF,
        pointSpikeTranscriptPMF, pointSpikePullCount]
  | succ t ih =>
      intro h
      rcases h with ⟨hprev, a, x⟩
      intro hbase
      rw [pointSpikeBaseTranscriptPMF_apply_succ] at hbase
      have hbasePrev :
          pointSpikeBaseTranscriptPMF policy t hprev ≠ 0 := by
        intro hz
        apply hbase
        simp [hz]
      have hpolicy : policy t hprev a ≠ 0 := by
        intro hz
        apply hbase
        simp [hz]
      have hreward : spikeBasePMF x ≠ 0 := by
        intro hz
        apply hbase
        simp [hz]
      have haltPrev :
          pointSpikeAltTranscriptPMF policy target tau t hprev ≠ 0 :=
        pointSpikeAltTranscriptPMF_pos_of_base policy target tau t hprev hbasePrev
      have haltReward :
          pointSpikeAlternativeReward target tau t a x ≠ 0 := by
        by_cases hchange : tau ≤ t + 1 ∧ a = target
        · simpa [pointSpikeAlternativeReward, hchange] using
            (spike_alternative_positive_on_base_support x hreward)
        · simpa [pointSpikeAlternativeReward, hchange] using hreward
      have hprevReal :
          (pointSpikeAltTranscriptPMF policy target tau t hprev).toReal ≠ 0 :=
        pointSpikePMF_toReal_ne_zero _ _ haltPrev
      have hpolicyReal : (policy t hprev a).toReal ≠ 0 :=
        pointSpikePMF_toReal_ne_zero _ _ hpolicy
      have hrewardAltReal :
          (pointSpikeAlternativeReward target tau t a x).toReal ≠ 0 :=
        pointSpikePMF_toReal_ne_zero _ _ haltReward
      calc
        (pointSpikeBaseTranscriptPMF policy (t + 1) (hprev, (a, x))).toReal /
            (pointSpikeAltTranscriptPMF policy target tau (t + 1)
              (hprev, (a, x))).toReal
          =
          ((pointSpikeBaseTranscriptPMF policy t hprev).toReal *
              (policy t hprev a).toReal * (spikeBasePMF x).toReal) /
            ((pointSpikeAltTranscriptPMF policy target tau t hprev).toReal *
              (policy t hprev a).toReal *
              (pointSpikeAlternativeReward target tau t a x).toReal) := by
                rw [pointSpikeBaseTranscriptPMF_apply_succ,
                  pointSpikeAltTranscriptPMF_apply_succ]
                simp only [ENNReal.toReal_mul]
        _ =
          ((pointSpikeBaseTranscriptPMF policy t hprev).toReal /
              (pointSpikeAltTranscriptPMF policy target tau t hprev).toReal) *
            ((spikeBasePMF x).toReal /
              (pointSpikeAlternativeReward target tau t a x).toReal) := by
                field_simp [hprevReal, hpolicyReal, hrewardAltReal]
        _ =
          (5 / 3 : ℝ) ^ pointSpikePullCount target tau t hprev *
            ((spikeBasePMF x).toReal /
              (pointSpikeAlternativeReward target tau t a x).toReal) := by
                rw [ih hprev hbasePrev]
        _ = (5 / 3 : ℝ) ^ pointSpikePullCount target tau (t + 1)
              (hprev, (a, x)) := by
                rw [pointSpike_reward_likelihood_ratio target tau t a x hreward]
                by_cases hchange : tau ≤ t + 1 ∧ a = target
                · simp [pointSpikePullCount, hchange, pow_succ, mul_comm]
                · simp [pointSpikePullCount, hchange]



/-- Finite action/reward histories inherit a computable finite type. -/
@[instance_reducible]
private def pointSpikeHistoryFintype (A X : Type*) [Fintype A] [Fintype X] :
    (t : ℕ) → Fintype (SequentialHistory A X t)
  | 0 => by
      change Fintype PUnit
      infer_instance
  | t + 1 => by
      letI := pointSpikeHistoryFintype A X t
      change Fintype (SequentialHistory A X t × (A × X))
      infer_instance

private instance instPointSpikeHistoryFintype {A : ℕ} (t : ℕ) :
    Fintype (SequentialHistory (Fin A) (Fin 3) t) :=
  pointSpikeHistoryFintype (Fin A) (Fin 3) t

/-- Expected number of post-change pulls of the target action under the baseline. -/
def pointSpikeExpectedPullCount {A : ℕ}
    (policy : (t : ℕ) → SequentialHistory (Fin A) (Fin 3) t → PMF (Fin A))
    (target : Fin A) (tau t : ℕ) : ℝ :=
  ∑ h : SequentialHistory (Fin A) (Fin 3) t,
    (pointSpikeBaseTranscriptPMF policy t h).toReal *
      (pointSpikePullCount target tau t h : ℝ)

/-- Discrete KL divergence of two finite transcript PMFs, with 0 log(0/q)=0. -/
def pointSpikeTranscriptDiscreteKL {A : ℕ}
    (policy : (t : ℕ) → SequentialHistory (Fin A) (Fin 3) t → PMF (Fin A))
    (target : Fin A) (tau t : ℕ) : ℝ :=
  ∑ h : SequentialHistory (Fin A) (Fin 3) t,
    if pointSpikeBaseTranscriptPMF policy t h = 0 then 0 else
      (pointSpikeBaseTranscriptPMF policy t h).toReal *
        Real.log ((pointSpikeBaseTranscriptPMF policy t h).toReal /
          (pointSpikeAltTranscriptPMF policy target tau t h).toReal)

/--
The exact finite-transcript discrete KL equals log(5/3) times the expected
number of post-change pulls of the target arm. This is the finite-sum
specialization of the path likelihood-ratio identity; it does not yet
identify the discrete sum with Mathlib's measure-level KL divergence.
-/
theorem pointSpikeTranscriptDiscreteKL_eq_log_mul_expected_pulls {A : ℕ}
    (policy : (t : ℕ) → SequentialHistory (Fin A) (Fin 3) t → PMF (Fin A))
    (target : Fin A) (tau t : ℕ) :
    pointSpikeTranscriptDiscreteKL policy target tau t =
      Real.log (5 / 3) * pointSpikeExpectedPullCount policy target tau t := by
  classical
  unfold pointSpikeTranscriptDiscreteKL pointSpikeExpectedPullCount
  calc
    (∑ h : SequentialHistory (Fin A) (Fin 3) t,
        if pointSpikeBaseTranscriptPMF policy t h = 0 then 0 else
          (pointSpikeBaseTranscriptPMF policy t h).toReal *
            Real.log ((pointSpikeBaseTranscriptPMF policy t h).toReal /
              (pointSpikeAltTranscriptPMF policy target tau t h).toReal))
      =
    ∑ h : SequentialHistory (Fin A) (Fin 3) t,
      ((pointSpikeBaseTranscriptPMF policy t h).toReal *
        (pointSpikePullCount target tau t h : ℝ)) * Real.log (5 / 3) := by
          apply Finset.sum_congr rfl
          intro h hh
          by_cases hbase : pointSpikeBaseTranscriptPMF policy t h = 0
          · simp [hbase]
          · have hratio :=
              pointSpikeTranscript_toReal_likelihood_ratio policy target tau t h hbase
            simp only [if_neg hbase]
            rw [hratio, Real.log_pow]
            ring
    _ =
      (∑ h : SequentialHistory (Fin A) (Fin 3) t,
        (pointSpikeBaseTranscriptPMF policy t h).toReal *
          (pointSpikePullCount target tau t h : ℝ)) * Real.log (5 / 3) := by
            rw [Finset.sum_mul]
    _ =
      Real.log (5 / 3) *
        (∑ h : SequentialHistory (Fin A) (Fin 3) t,
          (pointSpikeBaseTranscriptPMF policy t h).toReal *
            (pointSpikePullCount target tau t h : ℝ)) := by ring


end BudgetFreeBandits
